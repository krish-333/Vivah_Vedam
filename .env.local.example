# Database (AWS RDS PostgreSQL)
# Format: postgresql://<user>:<password>@<rds-endpoint>:5432/<dbname>
DATABASE_URL=postgresql://vivahvedam_app:CHANGE_ME@your-db.xxxxxxxxxx.ap-south-1.rds.amazonaws.com:5432/vivahvedam
# Set to "false" only for local Postgres without TLS. Leave unset/true for RDS.
DATABASE_SSL=true

# Session auth (JWT + bcrypt, our own — see src/lib/auth/session.ts)
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_to_a_random_48+_char_secret

# File storage (AWS S3 — contract PDFs, vendor logos/cover photos)
# No access keys here on purpose: the EC2 instance uses an IAM instance role
# (see AWS_DEPLOYMENT.md §10) so the AWS SDK picks up credentials automatically.
AWS_REGION=ap-south-1
S3_UPLOADS_BUCKET=vivahvedam-uploads

# Google OAuth (used for "Continue with Google") - optional
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (unchanged)
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Platform
PLATFORM_COMMISSION_RATE=0.10
NEXT_PUBLIC_APP_URL=https://your-domain.com
